meta {
  name: projects
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/projects
  body: none
  auth: none
}

headers {
  X-User-Id: {{id_hod}}
}

assert {
  res.status: eq 200
  res.body: isArray
}

script:pre-request {
  const axios = require("axios");
  const users = (await axios.get(bru.getEnvVar("baseUrl") + "/users?role=hod")).data;
  bru.setVar("id_hod", users[0].id);
}
