meta {
  name: login hod
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  { "username": "hod", "password": "{{process.env.SEED_PASSWORD}}" }
}

assert {
  res.status: eq 200
  res.body.user.role: eq hod
}

script:post-response {
  bru.setVar("token", res.body.token);
}
