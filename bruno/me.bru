meta {
  name: me
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: none
}

headers {
  X-User-Id: {{id_hod}}
}

assert {
  res.status: eq 200
  res.body.role: eq hod
}

script:pre-request {
  const axios = require("axios");
  const users = (await axios.get(bru.getEnvVar("baseUrl") + "/users?role=hod")).data;
  bru.setVar("id_hod", users[0].id);
}
