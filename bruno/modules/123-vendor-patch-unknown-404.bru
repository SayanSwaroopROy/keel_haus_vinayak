meta {
  name: vendor patch unknown 404
  type: http
  seq: 123
}

patch {
  url: {{baseUrl}}/vendors/00000000-0000-0000-0000-000000000000
  body: json
  auth: none
}

headers {
  X-User-Id: {{id_hod}}
}

body:json {
  { "status": "active" }
}

assert {
  res.status: eq 404
  res.body.error.code: eq not_found
}
