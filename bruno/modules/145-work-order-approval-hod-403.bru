meta {
  name: work order approval hod 403
  type: http
  seq: 145
}

post {
  url: {{baseUrl}}/work-orders/00000000-0000-0000-0000-000000000000/approval
  body: json
  auth: none
}

headers {
  X-User-Id: {{id_hod}}
}

body:json {
  { "action": "approve" }
}

assert {
  res.status: eq 403
  res.body.error.code: eq forbidden
}
