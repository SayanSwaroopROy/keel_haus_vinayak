meta {
  name: rfq revision unknown 404
  type: http
  seq: 120
}

post {
  url: {{baseUrl}}/rfqs/00000000-0000-0000-0000-000000000000/request-revision
  body: json
  auth: none
}

headers {
  X-User-Id: {{id_hod}}
}

body:json {
  { "vendor_id": "00000000-0000-0000-0000-000000000000", "note": "x" }
}

assert {
  res.status: eq 404
  res.body.error.code: eq not_found
}
