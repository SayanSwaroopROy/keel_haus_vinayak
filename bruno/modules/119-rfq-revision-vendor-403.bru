meta {
  name: rfq revision vendor 403
  type: http
  seq: 119
}

post {
  url: {{baseUrl}}/rfqs/00000000-0000-0000-0000-000000000000/request-revision
  body: json
  auth: none
}

headers {
  X-User-Id: {{id_vendor_a}}
}

body:json {
  { "vendor_id": "00000000-0000-0000-0000-000000000000", "note": "x" }
}

assert {
  res.status: eq 403
  res.body.error.code: eq forbidden
}
