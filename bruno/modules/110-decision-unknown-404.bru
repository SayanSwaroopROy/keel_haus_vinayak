meta {
  name: decision unknown 404
  type: http
  seq: 110
}

post {
  url: {{baseUrl}}/requisitions/00000000-0000-0000-0000-000000000000/decision
  body: json
  auth: none
}

headers {
  X-User-Id: {{id_hod}}
}

body:json {
  { "action": "approve" }
}

assert {
